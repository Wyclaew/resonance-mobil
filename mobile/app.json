{
  "expo": {
    "name": "Resonance",
    "slug": "resonance-mobil",
    "scheme": "resonance",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c0c0d",
    "newArchEnabled": true,
    "android": {
      "package": "com.resonance.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 3
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraMavenRepos": [
              "https://jitpack.io"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# NewPipeExtractor: yansıma + Rhino JS yorumlayıcısı (imza çözme) — küçültülürse çıkarım sessizce kırılır.\n-keep class org.schabi.newpipe.extractor.** { *; }\n-keep class org.mozilla.javascript.** { *; }\n-keep class org.mozilla.classfile.** { *; }\n-keep class com.resonance.extractor.** { *; }\n-dontwarn org.mozilla.javascript.**\n-dontwarn javax.script.**\n-dontwarn java.beans.**\n-dontwarn org.jsoup.**\n-dontwarn com.google.re2j.**\n-dontwarn org.slf4j.**"
          }
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0c0d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0c0c0d",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.resonance.mobile"
    }
  }
}
